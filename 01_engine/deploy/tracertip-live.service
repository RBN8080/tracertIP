# Live telemetry: tracertip serve. Targets are typed into the live view on
# the LAN (at most 5 at once) and probed without end; the list is kept in
# /var/lib/tracertip/live with the history. Raw sockets through an ambient
# capability only. LISTEN comes from /etc/tracertip/live.env (a private LAN
# address; template live.env.example).
[Unit]
Description=tracertip: live telemetry
Documentation=https://github.com/RBN8080/tracertIP
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=tracertip
Group=tracertip
StateDirectory=tracertip
StateDirectoryMode=0755
EnvironmentFile=/etc/tracertip/live.env
ExecStart=/usr/local/bin/tracertip serve -state /var/lib/tracertip/live -config /etc/tracertip/live.json -dir /var/lib/tracertip/bases -listen ${LISTEN}
Restart=always
RestartSec=30
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
