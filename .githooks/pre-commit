#!/bin/sh
# tracertIP - publishability checker
#   git commit ................................ checks what is staged
#   git hook run pre-commit -- --all .......... all tracked files
#   git hook run pre-commit -- --history ...... the whole history
# Layer 1: generic patterns (this file, public)
# Layer 2: private lists, OUTSIDE the repository
# Layer 3: gitleaks (credentials)
# Fails closed: missing lists or gitleaks BLOCK the commit.
# Repository file names carry no spaces (convention).
set -u

MODE="${1:-staged}"
ROOT="$(git rev-parse --show-toplevel)" || exit 1
PRIV="${TRACERTIP_PRIVATE:-$ROOT/../_privado/09_tracertIP}"
[ -f "$PRIV/denylist-palabras.txt" ] && [ -f "$PRIV/denylist-fragmentos.txt" ] || {
  echo "BLOCKED: private lists not found in $PRIV" >&2; exit 1; }
command -v gitleaks >/dev/null 2>&1 || {
  echo "BLOCKED: gitleaks is missing" >&2; exit 1; }

# Lists without CR or blank lines (a blank line would match EVERYTHING)
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
for l in palabras fragmentos; do
  tr -d '\r' < "$PRIV/denylist-$l.txt" | grep -v '^[[:space:]]*$' > "$TMP/$l"
done

case "$MODE" in
  staged)
    FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
    [ -z "$FILES" ] && exit 0
    git grep --cached -n -I -e '' -- $FILES > "$TMP/text" ;;
  --all)
    git grep --cached -n -I -e '' > "$TMP/text" ;;
  --history)
    git log -p --all --no-color --format='commit %H %ae' > "$TMP/text" ;;
  *) echo "usage: pre-commit [--all | --history]" >&2; exit 2 ;;
esac

FINDINGS=0
check() {  # $1 = description; the rest are grep arguments
  d="$1"; shift
  if grep "$@" "$TMP/text" > "$TMP/hit"; then
    echo "PUBLISHABILITY - $d:" >&2; head -n 20 "$TMP/hit" >&2; FINDINGS=1
  fi
}

# Layer 1: generic. Networks in CIDR notation (x.x.x.x/nn) are allowed.
check "private or CGNAT host IP" -E \
  '(^|[^0-9.])(10(\.[0-9]{1,3}){3}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2}|192\.168(\.[0-9]{1,3}){2}|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])(\.[0-9]{1,3}){2})([^0-9./]|$)'
grep -E '([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}' "$TMP/text" \
  | grep -v -i -E '00[:-]00[:-]5e[:-]00[:-]53' > "$TMP/mac"
[ -s "$TMP/mac" ] && { echo "PUBLISHABILITY - real MAC:" >&2; head -n 20 "$TMP/mac" >&2; FINDINGS=1; }
check "private key" -E -- '-----BEGIN [A-Z ]*PRIVATE KEY-----'
check "token in URL" -E '[?&](token|key|apikey|api_key)=[A-Za-z0-9_-]{8,}'
check "user path" -E '[A-Za-z]:\\Users\\[A-Za-z0-9._-]+|/home/[a-z]'
grep -E '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' "$TMP/text" \
  | grep -v -E '@users\.noreply\.github\.com|@example\.(com|org|net)' > "$TMP/mail"
[ -s "$TMP/mail" ] && { echo "PUBLISHABILITY - e-mail:" >&2; head -n 20 "$TMP/mail" >&2; FINDINGS=1; }

# Layer 2: private lists
check "private term (word)" -i -w -F -f "$TMP/palabras"
check "private fragment" -i -F -f "$TMP/fragmentos"

# Layer 3: gitleaks
case "$MODE" in
  staged)    gitleaks git --pre-commit --staged --redact --no-banner >&2 || FINDINGS=1 ;;
  --all)     gitleaks dir "$ROOT" --redact --no-banner >&2 || FINDINGS=1 ;;
  --history) gitleaks git "$ROOT" --redact --no-banner >&2 || FINDINGS=1 ;;
esac

if [ "$FINDINGS" -ne 0 ]; then
  echo "BLOCKED: fix the content; --no-verify is forbidden." >&2
  exit 1
fi
exit 0
