# Defense in depth: private data lives OUTSIDE the repository
# (../_privado/). If something is copied here by mistake, git ignores it.
privado/
_privado/
datos/
*.pcap
*.pcapng
*.etl
*.jsonl
# ...except SYNTHETIC test data (documentation values)
!00_verification/analysis/testdata/*.jsonl
.env
.env.*
# Binaries
*.exe
00_verification/analysis/analysis
/tracertip
/bin/
